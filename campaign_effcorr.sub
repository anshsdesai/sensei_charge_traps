# HTCondor submit for the trap-only (zero dark-current) BRACKET campaign:
# effcorr + upper populations, single-electron dark current zeroed. One job per
# (scenario label, charge mode, trial offset); each runs a short chunk of trials
# on a single 1-core slot. Generate joblist_effcorr.txt with
# `bash make_joblist_effcorr.sh` first, then `condor_submit campaign_effcorr.sub`.
#
# Disjoint output dirs (labels carry the _zedr tag) from the headline campaign,
# so this is safe to submit alongside in-flight headline jobs.
#
# Run through /bin/bash (not the script directly) so a stray shebang/exec-format
# issue can never block scheduling; run_one_effcorr.sh is found on shared NFS home.
universe              = vanilla
executable            = /bin/bash
transfer_executable   = false
should_transfer_files = NO
initialdir            = /export/home/adesai/Projects/sensei_charge_traps
arguments             = "run_one_effcorr.sh $(label) $(mode) $(offset) $(chunk)"

output                = condor_logs/effcorr_$(mode)_$(label)_$(offset).out
error                 = condor_logs/effcorr_$(mode)_$(label)_$(offset).err
log                   = condor_logs/effcorr_campaign.log

request_cpus          = 1
request_memory        = 3000
request_disk          = 100000

queue label, mode, offset, chunk from joblist_effcorr.txt
