# HTCondor submit for the physical E/sigma BASELINE campaign.
# One job per (scenario label, charge mode, trial offset); each runs a short
# chunk of trials on a single 1-core slot. Corrected/upper jobs use
# campaign_effcorr.sub instead. Generate joblist.txt with
# `bash make_joblist.sh` first, then `condor_submit campaign.sub`.
#
# Run through /bin/bash (not the script directly) so a stray shebang/exec-format
# issue can never block scheduling; run_one.sh is found on the shared NFS home.
universe              = vanilla
executable            = /bin/bash
transfer_executable   = false
should_transfer_files = NO
initialdir            = /export/home/adesai/Projects/sensei_charge_traps
arguments             = "run_one.sh $(label) $(mode) $(offset) $(chunk)"

output                = condor_logs/$(mode)_$(label)_$(offset).out
error                 = condor_logs/$(mode)_$(label)_$(offset).err
log                   = condor_logs/campaign.log

request_cpus          = 1
request_memory        = 3000
request_disk          = 100000

# Exclude hepatl33: its writes to the NFS home (hepatl30:/home) fail with
# OSError errno 5 (EIO) at HDF5 close(), so trials die mid-chunk and leave
# orphaned ccd_traps_run*.h5.tmp<pid> files. Clean until 2026-07-16, ~100%
# failure by 07-28. It also acts as a black hole: a failed job dies in ~0.9 h
# vs ~2.6 h for real work, so its slots free up ~3x faster and vacuum up the
# queue -- in cluster 37272 it took 116/160 jobs and killed every one, while
# all 44 jobs on hepatl31/32/34 succeeded. Remove once the node is repaired.
requirements          = (Machine != "hepatl33.uoregon.edu")

queue label, mode, offset, chunk from joblist.txt
